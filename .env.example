# Desarrollo local únicamente. Copia a .env para personalizar; no uses estos valores en producción.
POSTGRES_DB=trackhive
POSTGRES_USER=user
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
SEED_ADMIN_PASSWORD=1
SEED_DEMO_PASSWORD=1

# Conexión de Prisma y del backend local; se construye con las variables de arriba.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
