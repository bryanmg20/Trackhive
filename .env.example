# Local development only. Copy to .env to customize; do not use these values in production.
POSTGRES_DB=trackhive
POSTGRES_USER=user
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
SEED_ADMIN_PASSWORD=1
SEED_DEMO_PASSWORD=1
RUN_SEED=true
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Mail (HU-22). By default the backend sends to Mailpit, which keeps the emails
# without sending them; see them at http://localhost:8025. Inside Docker the host
# is "mailpit"; when running the backend with pnpm start:dev, use localhost.
# For real delivery, set your SMTP server and credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Trackhive <no-reply@example.com>"

# Prisma and local backend connection, built from the variables above.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
