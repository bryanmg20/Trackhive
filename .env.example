# Local development only. Copy to .env to customize; do not use these values in production.
POSTGRES_DB=trackhive
POSTGRES_USER=user
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
SEED_ADMIN_PASSWORD=1
SEED_DEMO_PASSWORD=1
RUN_SEED=true
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Mail (HU-22). By default the backend sends to Mailpit, which keeps the emails
# without sending them; see them at http://localhost:8025. Inside Docker the host
# is "mailpit"; when running the backend with pnpm start:dev, use localhost.
# For real delivery, set your SMTP server and credentials (Gmail: smtp.gmail.com,
# port 465 and an app password; see docs/manual-operacion.md). HU-23 emails the
# requester on every status change through this server.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Trackhive <no-reply@example.com>"

# Sync with Everything (E11, HU-137). The backend never calls Everything: the
# agent (HU-166) queries it and sends each page to the ingest endpoints with
# EVERYTHING_AGENT_TOKEN in "Authorization: Bearer <token>". Empty = the sync is
# disabled, those endpoints answer 503 and the screen «Sincronización» says so
# (HU-138). To enable it, generate a token of at
# least 32 characters (openssl rand -hex 32) and give the same one to the agent
# (trackhive.token in agent/agente.toml). Never commit a real token
# (docs/everything-desarrollo.md, section 7).
EVERYTHING_AGENT_TOKEN=
# A run that receives no page for this many minutes expires with an error, and
# then nothing is marked as «copia digital no encontrada»
EVERYTHING_RUN_TIMEOUT_MINUTES=30

# Everything HTTP server mock (HU-133), for development without Windows. The
# user and password are the ones of the mock; the backend does not use them, and
# the agent (HU-166) reads those of Everything from its own agent/agente.toml.
EVERYTHING_USER=trackhive
EVERYTHING_PASSWORD=trackhive-dev
# Port where the mock is published on this machine
EVERYTHING_MOCK_PORT=8081

# Prisma and local backend connection, built from the variables above.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
