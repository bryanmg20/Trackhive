// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserModel {
  id               String              @id @db.Uuid
  fullName         String              @map("full_name") @db.VarChar(120)
  email            String              @unique @db.VarChar(160)
  passwordHash     String              @map("password_hash") @db.VarChar(255)
  // Allowed values (CHECK in the migration): ADMIN, PERSONAL, PUBLICO
  role             String              @db.VarChar(10)
  active           Boolean             @default(true)
  lastLoginAt      DateTime?           @map("last_login_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  refreshTokens    RefreshTokenModel[]
  requester        RequesterModel?
  createdRequests  RequestModel[]      @relation("RequestCreatedBy")
  assignedRequests RequestModel[]      @relation("RequestAssignee")

  @@map("users")
}

// One row per issued refresh token. Only its SHA-256 hash is stored (D-11)
model RefreshTokenModel {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  // NULL = still valid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // No cascade: a user with sessions is deactivated, not deleted
  user      UserModel @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refresh_tokens")
}

// A piece of the archive collection (HU-07). The GIN trigram indexes need the
// pg_trgm extension, which is created by hand in the migration (D-16)
model MaterialModel {
  id              String             @id @db.Uuid
  catalogCode     String             @unique @map("catalog_code") @db.VarChar(40)
  title           String             @db.VarChar(255)
  // Allowed values (CHECK in the migration): DOCUMENTO, PERIODICO, PROTOCOLO_NOTARIAL, OTRO
  materialType    String             @map("material_type") @db.VarChar(20)
  author          String?            @db.VarChar(150)
  collection      String             @db.VarChar(120)
  // Periodicals only (HU-06). Nullable: some historic periodicals lack them
  publicationDate DateTime?          @map("publication_date") @db.Date
  publisher       String?            @db.VarChar(150)
  // Physical location. Never shown to the PUBLICO role
  depot           String             @db.VarChar(40)
  shelf           String             @db.VarChar(40)
  box             String             @db.VarChar(40)
  // Allowed values (CHECK in the migration): DISPONIBLE, EN_USO, EN_RESTAURACION, NO_CONSULTABLE
  status          String             @db.VarChar(20)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  requestItems    RequestItemModel[]

  @@index([materialType])
  // Text search with ILIKE '%...%' (HU-07)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_title_trgm_idx")
  @@index([author(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_author_trgm_idx")
  @@index([collection(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_collection_trgm_idx")
  @@map("materials")
}

model RequesterModel {
  id                    String         @id @db.Uuid
  userId                String?        @unique @map("user_id") @db.Uuid
  documentType          String?        @map("document_type") @db.VarChar(5)
  documentNumber        String?        @map("document_number") @db.VarChar(20)
  firstNames            String         @map("first_names") @db.VarChar(80)
  lastNames             String         @map("last_names") @db.VarChar(80)
  email                 String?        @db.VarChar(160)
  phone                 String?        @db.VarChar(20)
  requesterType         String         @map("requester_type") @db.VarChar(15)
  institution           String?        @db.VarChar(150)
  acceptsDataProcessing Boolean        @map("accepts_data_processing")
  consentedAt           DateTime       @map("consented_at") @db.Timestamptz
  privacyPolicyVersion  String         @map("privacy_policy_version") @db.VarChar(10)
  anonymizedAt          DateTime?      @map("anonymized_at") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user                  UserModel?     @relation(fields: [userId], references: [id])
  requests              RequestModel[]

  @@unique([documentType, documentNumber])
  @@index([documentNumber])
  @@index([email])
  @@index([firstNames(ops: raw("gin_trgm_ops")), lastNames(ops: raw("gin_trgm_ops"))], type: Gin, map: "requesters_name_trgm_idx")
  @@map("requesters")
}

model RequestModel {
  id                     String             @id @db.Uuid
  trackingCode           String             @unique @map("tracking_code") @db.VarChar(16)
  requesterId            String             @map("requester_id") @db.Uuid
  createdById            String             @map("created_by_id") @db.Uuid
  assigneeId             String?            @map("assignee_id") @db.Uuid
  requestType            String             @map("request_type") @db.VarChar(25)
  originChannel          String             @map("origin_channel") @db.VarChar(10)
  deliveryMode           String             @map("delivery_mode") @db.VarChar(10)
  purpose                String             @map("purpose") @db.VarChar(15)
  reason                 String?
  requirementDescription String             @map("requirement_description")
  desiredDate            DateTime           @map("desired_date") @db.Date
  committedDate          DateTime?          @map("committed_date") @db.Date
  priority               String             @default("MEDIA") @db.VarChar(5)
  status                 String             @default("RECIBIDA") @db.VarChar(12)
  rejectionReason        String?            @map("rejection_reason") @db.VarChar(25)
  notes                  String?
  registeredAt           DateTime           @default(now()) @map("registered_at") @db.Timestamptz
  attendedAt             DateTime?          @map("attended_at") @db.Timestamptz
  closedAt               DateTime?          @map("closed_at") @db.Timestamptz
  version                Int                @default(1)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  requester              RequesterModel     @relation(fields: [requesterId], references: [id])
  createdBy              UserModel          @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee               UserModel?         @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  items                  RequestItemModel[]

  @@index([requesterId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([status, committedDate])
  @@index([registeredAt])
  @@map("requests")
}

model RequestItemModel {
  id         String        @id @db.Uuid
  requestId  String        @map("request_id") @db.Uuid
  materialId String        @map("material_id") @db.Uuid
  itemStatus String        @default("PENDIENTE") @map("item_status") @db.VarChar(15)
  accessType String        @default("FISICO") @map("access_type") @db.VarChar(10)
  note       String?
  request    RequestModel  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  material   MaterialModel @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([requestId, materialId])
  @@index([materialId])
  @@map("request_items")
}
